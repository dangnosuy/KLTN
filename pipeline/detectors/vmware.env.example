# VMware connection for the Defender static-scanning VM. Do not commit real values.
export VMRUN_VMX='/absolute/path/to/Windows.vmx'
export VM_GUEST_USER='vmrunuser'
export VM_GUEST_PASSWORD='replace-this-password'
# Only set this if the VMX is encrypted.
# export VMRUN_VM_PASSWORD='replace-this-password'
export VMRUN_TOOLS_TIMEOUT_SECONDS='120'
